# Copy to .env and adjust as needed. Every app also has its own sane
# defaults matching infra/docker/docker-compose.yml, so this file only
# needs to be sourced when running an app outside docker-compose.

DATABASE_URL=postgresql://streaming:streaming@localhost:5432/streaming
RABBITMQ_URL=amqp://streaming:streaming@localhost:5672

S3_ENDPOINT=http://localhost:9000
# Only needed when S3_ENDPOINT isn't already reachable from a browser (e.g.
# inside docker-compose, where it's the internal `minio` hostname) - see
# StorageClient's presignS3 and infra/docker/docker-compose.yml.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=streaming
S3_SECRET_ACCESS_KEY=streamingsecret
S3_RAW_BUCKET=raw
S3_HLS_BUCKET=hls

PORT=3001
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg

NEXT_PUBLIC_UPLOAD_API_URL=http://localhost:3001
NEXT_PUBLIC_STREAM_API_URL=http://localhost:3002
