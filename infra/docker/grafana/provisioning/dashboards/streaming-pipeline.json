{
  "title": "Streaming pipeline",
  "uid": "streaming-pipeline",
  "editable": true,
  "schemaVersion": 39,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Queue depth",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "streaming_queue_depth",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Jobs/s by service and outcome",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (service, outcome) (rate(streaming_jobs_total[1m]))",
          "legendFormat": "{{service}} ({{outcome}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "DLQ rate by service",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (service) (rate(streaming_jobs_total{outcome=\"dead-letter\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Job duration (p50/p95) by service",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.5, sum by (service, le) (rate(streaming_job_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{service}}",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(streaming_job_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{service}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tempo total por vídeo (upload até READY, p50/p95)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(streaming_video_total_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(streaming_video_total_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Videos reaching READY (rate)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(streaming_video_total_duration_seconds_count[5m]))",
          "legendFormat": "videos/s",
          "refId": "A"
        }
      ]
    }
  ]
}
